# Shared fallback (used when a per-account value below is omitted)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000

# Optional: one OAuth Desktop client per inbox (recommended when you have 3 projects)
# GOOGLE_CLIENT_ID_ACCOUNT1=...
# GOOGLE_CLIENT_SECRET_ACCOUNT1=...
# GOOGLE_REDIRECT_URI_ACCOUNT1=http://localhost:3000
# GOOGLE_CLIENT_ID_ACCOUNT2=...
# GOOGLE_CLIENT_SECRET_ACCOUNT2=...
# GOOGLE_REDIRECT_URI_ACCOUNT2=http://localhost:3001
# GOOGLE_CLIENT_ID_ACCOUNT3=...
# GOOGLE_CLIENT_SECRET_ACCOUNT3=...
# GOOGLE_REDIRECT_URI_ACCOUNT3=http://localhost:3002

# Inbox labels used by --all / npm run fetch:all / npm run auth:all
GMAIL_ACCOUNTS=account1,account2,account3

# Gmail search query for which messages to fetch
# GMAIL_QUERY=is:unread

# Set to 0 to keep attachments only in memory
SAVE_ATTACHMENTS_TO_DISK=1
